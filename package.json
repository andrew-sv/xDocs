{
  "name": "xdocs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"pnpm -F @xdocs/api dev\" \"pnpm -F @xdocs/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:push": "pnpm -F @xdocs/api db:push",
    "e2e": "pnpm -F @xdocs/web e2e",
    "test": "pnpm -F @xdocs/web test",
    "integration": "pnpm -F @xdocs/web integration",
    "smoke": "pnpm -F @xdocs/web smoke",
    "start": "pnpm -F @xdocs/api start"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.1"
}

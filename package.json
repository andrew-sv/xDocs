{
  "name": "xdocs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"pnpm -F @xdocs/api dev\" \"pnpm -F @xdocs/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "e2e": "pnpm -F @xdocs/web e2e",
    "test": "pnpm -F @xdocs/web test",
    "integration": "node scripts/integration.mjs",
    "smoke": "pnpm -F @xdocs/web smoke",
    "start": "pnpm -F @xdocs/api start",
    "db:generate": "pnpm -F @xdocs/api db:generate",
    "db:migrate": "pnpm -F @xdocs/api db:migrate",
    "db:check": "pnpm -F @xdocs/api db:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.1"
}
